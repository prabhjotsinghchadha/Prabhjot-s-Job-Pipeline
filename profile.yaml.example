personal:
  first_name: Your
  last_name: Name
  email: you@example.com
  phone: +1-555-000-0000
  location: San Francisco, CA
  linkedin: https://linkedin.com/in/yourprofile
  github: https://github.com/yourusername
  portfolio: https://yoursite.com
resume_path: ./resume.pdf
preferences:
  roles:
  - Software Engineer
  - Backend Engineer
  - Full Stack Engineer
  - Platform Engineer
  keywords:
  - Python
  - Rust
  - distributed systems
  - AI
  min_match_score: 65
  remote_only: false
  locations:
  - San Francisco
  - Remote
  exclude_companies:
  - ExampleBadCorp
common_answers:
  authorized_to_work: 'Yes'
  require_sponsorship: 'No'
  years_experience: '5'
  willing_to_relocate: Open to discussion
  salary_expectation: Open to discuss based on total compensation
  earliest_start_date: 2 weeks notice
  how_did_you_hear: Online job board
  gender: Prefer not to say
  race_ethnicity: Prefer not to say
  veteran_status: I am not a veteran
  disability_status: Prefer not to say
target_boards:
  greenhouse:
  - anthropic
  - stripe
  - figma
  - vercel
  - datadog
  lever:
  - anyscale
search:
  enabled: true
  queries:
  - Software Engineer
  - Backend Engineer
  locations:
  - San Francisco, CA
  - Remote
  distance_miles: 50
  results_per_query: 25
  salary_min: 0
skills:
  primary:
  - Python
  - Rust
  - Go
  - distributed systems
  secondary:
  - Kubernetes
  - Docker
  - AWS
  - PostgreSQL
  - React
ideal_job_description: 'A senior backend or platform engineering role at a technology
  company building distributed systems, developer tools, or AI infrastructure. Strong
  engineering culture, remote-friendly, competitive compensation.'
favorite_companies:
- anthropic
- stripe
- figma
- vercel
custom_career_pages: []

# Resume Builder — structured resume content rendered to ATS-friendly PDF/DOCX
# (dashboard PROFILE → RESUME BUILDER; GET /api/resume/build?format=pdf|docx).
# Per-job TAILOR rewrites summary/bullets/skills from THIS data and the apply
# adapters upload the tailored PDF when use_tailored_when_applying is true.
resume:
  headline: Senior Software Engineer
  summary: Two or three sentences on your level, stack, and biggest measurable wins.
  skills:
  - category: Languages & Frameworks
    items: [Python, TypeScript, React]
  - category: Cloud & Infrastructure
    items: [AWS, Docker, Kubernetes]
  experience:
  - company: Example Corp
    title: Senior Software Engineer
    location: Remote
    start: Jan 2022
    end: Present
    tagline: one-line description of the company (optional)
    bullets:
    - Led X, improving Y by Z%.
  education:
  - degree: B.S. Computer Science
    school: State University
    location: City, Country
    start: '2014'
    end: '2018'
    details: ''
  projects: []        # {name, url, description, tech: [], bullets: []}
  certifications: []  # {name, issuer, year}
  awards: []
  languages: []
  use_tailored_when_applying: true
# Per-source discovery toggles — set any to false to skip that site.
# A missing key means enabled. Full catalog: utils/discovery.py SOURCE_REGISTRY.
sources:
  greenhouse: true
  lever: true
  jobspy: true
  remoteok: true
  yc_jobs: true
  remotive: true
  himalayas: true
  arbeitnow: true
  weworkremotely: true
  web3career: true
  adzuna: true
  hn: true
  career_pages: true
rate_limits:
  max_applications_per_day: 25
  min_delay_seconds: 60
  max_delay_seconds: 180
schedule:
  discover_interval_hours: 6
  score_interval_minutes: 30
  enabled: true
# Email — one account powers BOTH inbox checking (IMAP) and email-apply
# sending (SMTP). For Gmail create an App Password at
# https://myaccount.google.com/apppasswords and use it for app_password.
# smtp_server/smtp_port are optional — derived from imap_server when unset
# (imap.gmail.com -> smtp.gmail.com:465).
email:
  enabled: false            # inbox checking (status updates)
  imap_server: imap.gmail.com
  email: ''
  app_password: ''
  check_interval_hours: 12
  # smtp_server: smtp.gmail.com
  # smtp_port: 465

# AI Backend Configuration (optional — defaults to claude_cli for everything)
# Each component can independently use a different LLM backend.
ai:
  default_backend: claude_cli
  backends:
    claude_cli:
      timeout: 120
    gemini:
      api_key: ${GEMINI_API_KEY}
      model: gemini-2.5-flash
      timeout: 60
    # openai:
    #   api_key: ${OPENAI_API_KEY}
    #   model: gpt-4o
    #   timeout: 60
    # ollama:
    #   base_url: http://localhost:11434
    #   model: llama3
    #   timeout: 120
  components:
    scoring: claude_cli
    cover_letter: claude_cli
    resume_tailoring: claude_cli
    form_analysis: claude_cli
    email_classification: claude_cli
    profile_analysis: claude_cli
