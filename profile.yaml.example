# Copy to profile.yaml (gitignored) or just fill in Settings in the dashboard.

personal:
  first_name: Your
  last_name: Name
  email: you@example.com
  phone: +1-555-000-0000
  location: San Francisco, CA
  linkedin: https://linkedin.com/in/yourprofile
  github: https://github.com/yourusername
  portfolio: https://yoursite.com

resume_path: ./resumes/resume.pdf   # the uploaded PDF (set from the Resume screen)

preferences:
  roles:                 # used for searching and the title prefilter
    - Software Engineer
    - Full Stack Engineer
  keywords: [Python, TypeScript, distributed systems, AI]
  locations: [Remote, San Francisco]
  remote_only: true
  min_match_score: 65    # Inbox shows jobs scoring at least this
  exclude_companies: []
  prefilter:             # zero-token gate before Claude scoring
    enabled: true
    require_role_keyword: true   # title must relate to one of the roles above
    skip_junior: true
    skip_management: true
    max_age_days: 60             # 0 = off
    title_blocklist: []
    title_allowlist: []

skills:
  primary: [Python, TypeScript, React]
  secondary: [Docker, AWS, PostgreSQL]

ideal_job_description: >
  A senior engineering role at a product company, remote, strong engineering
  culture. Claude scores postings against this paragraph.

favorite_companies: [anthropic, stripe]   # +10 score

common_answers:          # shown with copy buttons in the apply kit
  authorized_to_work: 'Yes'
  require_sponsorship: 'No'
  years_experience: '5'
  willing_to_relocate: 'No'
  salary_expectation: Open to discuss based on total compensation
  earliest_start_date: 2 weeks notice
  how_did_you_hear: Online job board

# Where to look. Every source is optional; missing key = enabled.
sources:
  greenhouse: true
  lever: true
  jobspy: true           # Indeed / LinkedIn / Google
  remoteok: true
  yc_jobs: true
  remotive: true
  himalayas: true
  arbeitnow: true
  weworkremotely: true
  web3career: true
  adzuna: false          # needs ADZUNA_APP_ID / ADZUNA_APP_KEY in .env
  hn: true
  career_pages: true
target_boards:
  greenhouse: [anthropic, stripe, figma]   # boards.greenhouse.io/<slug>
  lever: [anyscale]                        # jobs.lever.co/<slug>
custom_career_pages: []  # any URL; scraped with Playwright + Claude
search:                  # jobspy
  enabled: true
  queries: [Software Engineer, Full Stack Engineer]
  locations: [Remote, San Francisco, CA]
  distance_miles: 50
  results_per_query: 25
  salary_min: 0

# Clients mode (the Jobs / Clients switch in the top bar). Claude scores gigs
# and prospects against this and writes pitches from it. Edit in Settings → Clients.
offer:
  enabled: false           # also look for clients on the schedule
  services: [Next.js + AI product builds, Fractional CTO]
  engagement_types: [fixed-scope, retainer, hourly]
  rate_min: 80             # USD/hour
  rate_max: 150
  min_budget: 5000         # smallest project worth a pitch
  availability: 20 hrs/week from next month
  ideal_client: Funded startup, 5-50 people, shipping a product, needs senior hands fast.
  red_flags: [equity only, unpaid trial, revenue share]
  case_studies:
    - {name: Example Corp, outcome: "Rebuilt checkout, +18% conversion", url: ""}
  gig_queries: [contract Next.js developer, freelance full stack engineer]
  prospect_stacks: [Next.js, TypeScript, React, Node.js]   # companies hiring these become prospects
  prospect_exclude: [vercel, stripe]                        # big companies rarely buy from individuals
  sources: {hn_freelancer: true, jobspy_contract: true, boards_contract: true, prospects_from_jobs: true}

schedule:
  enabled: true
  discover_interval_hours: 6
  score_interval_minutes: 30

# One Gmail account for both reading status updates (IMAP) and sending email
# applications (SMTP). Use an App Password: https://myaccount.google.com/apppasswords
email:
  enabled: false
  imap_server: imap.gmail.com
  email: ''
  app_password: ''
  check_interval_hours: 12

# Resume builder. The Resume screen edits this; PDF/DOCX, ATS checks and
# tailoring all render from it. Import from PDF fills it from resume_path.
resume:
  headline: Senior Software Engineer
  summary: Two or three sentences on your level, stack and biggest wins.
  skills:
    - category: Languages & Frameworks
      items: [Python, TypeScript, React]
  experience:
    - company: Example Corp
      title: Senior Software Engineer
      location: Remote
      start: Jan 2022
      end: Present
      tagline: ''
      bullets:
        - Led X, improving Y by Z%.
  education:
    - degree: B.S. Computer Science
      school: State University
      location: ''
      start: '2014'
      end: '2018'
      details: ''
  projects: []           # {name, url, description, tech: [], bullets: []}
  certifications: []     # {name, issuer, year}
  awards: []
  languages: []
  use_tailored_when_applying: true
